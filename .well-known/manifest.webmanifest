{
  "name": "Pixel Arcade",
  "short_name": "Pixel Arcade",
  "version": "0.0.0",
  "update_manifest_url": "https://pixel-arcade-app.github.io/.well-known/updates.json",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#070a12",
  "theme_color": "#070a12",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "permissions_policy": {
    "fullscreen": ["self"]
  }
}
